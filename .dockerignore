# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Git files
/.git/
/.gitignore
/.gitattributes
/.gitmodules

# Documentation
README.md
TESTES_README.md
/doc/
/docs/

# Bundler configuration
/.bundle

# Environment files
/.env*
!/.env.example

# Security files
/config/master.key
/config/credentials/*.key

# Logs and temporary files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
*.log

# Process files
/tmp/pids/*
!/tmp/pids/.keep

# Storage files
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Test and coverage files
/spec/
/test/
/coverage/
/.rspec
/.simplecov

# Development tools
/.vscode/
/.idea/
*.sublime-*
/.devcontainer

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# CI/CD files
/.github
/.gitlab-ci.yml
/.travis.yml
/.circleci/

# Build artifacts
/node_modules/
/vendor/bundle/

# Kamal deployment
/config/deploy*.yml
/.kamal

# Docker files
/.dockerignore
/Dockerfile*
/docker-compose*.yml

# Database files
*.sqlite3
*.sqlite3-*

# Editor configurations
/.rubocop_todo.yml
/.rubocop-*

# Runtime files
*.pid
.sass-cache/
